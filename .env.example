RELAY_BIND=127.0.0.1:8443
RELAY_SERVER_NAME=localhost
RELAY_STATE_DIR=./state
RELAY_TLS_CERT_CHAIN_FILE=./tls/fullchain.pem
RELAY_TLS_PRIVATE_KEY_FILE=./tls/privkey.pem
RELAY_CLIENT_CA_MODE=provided
RELAY_CLIENT_CA_FILE=./tls/client-ca.pem
# RELAY_CLIENT_CRL_FILE=./tls/client-crls.pem
RELAY_MAX_CONNECTIONS=256
RELAY_MAX_HANDSHAKES=32
